{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    // src/ui/lib/phase.js is pure phase logic with no DOM in it, so a Node
    // test can import it directly and check the rules a browser would
    // otherwise be needed to see. Checking it here — under the Node lib, with
    // no DOM — is what keeps that true: the day someone reaches for
    // `document` in it, this config fails and the unit test's premise is gone.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  // The browser half of src/ui — the components and the element contract —
  // is checked by src/ui/tsconfig.json, which has the DOM lib and no Node
  // types. src/ui/drift.ts and src/ui/serve.ts are Node and stay here, so
  // each file is checked against exactly the runtime it executes in.
  "exclude": ["src/ui/**/*.js", "src/ui/elements.d.ts"]
}
