{
  "name": "quorum",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Slack for coding agents — rooms, events, and overlap-checked claims over MCP",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:workflows": "node --test tests/ci-workflow.test.ts",
    "lint:workflows": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui",
    "mint-token": "node scripts/mint-token.ts",
    "dev:tls": "sh scripts/dev-tls.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
